{
  "/b/auth/api/login": {
    "post": {
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "description": "`POST /b/auth/api/login` request body.",
              "properties": {
                "email": {
                  "format": "email",
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "email",
                "password"
              ],
              "title": "LoginRequest",
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/auth/api/login` response body.",
                "properties": {
                  "access_token": {
                    "type": "string"
                  },
                  "default_redirect": {
                    "description": "Role-aware post-login redirect path",
                    "type": "string"
                  },
                  "expires_in": {
                    "description": "Access token lifetime in seconds",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "refresh_token": {
                    "type": "string"
                  },
                  "token_type": {
                    "description": "The only `token_type` this API issues.",
                    "enum": [
                      "Bearer"
                    ],
                    "type": "string"
                  },
                  "user": {
                    "description": "The caller's identity, as returned by a successful authentication.",
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "roles": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "id",
                      "email",
                      "roles",
                      "name"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "access_token",
                  "refresh_token",
                  "token_type",
                  "expires_in",
                  "default_redirect",
                  "user"
                ],
                "title": "LoginResponse",
                "type": "object"
              }
            }
          },
          "description": "Successful response"
        }
      },
      "summary": "Authenticate with email/password",
      "tags": [
        "auth"
      ]
    }
  },
  "/b/auth/api/logout": {
    "post": {
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/auth/api/logout` response body.",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ],
                "title": "LogoutResponse",
                "type": "object"
              }
            }
          },
          "description": "Successful response"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Sign out",
      "tags": [
        "auth"
      ]
    }
  },
  "/b/auth/api/me": {
    "get": {
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`GET /b/auth/api/me` and `PATCH /b/auth/api/me` response body.",
                "properties": {
                  "user": {
                    "description": "The caller's own profile.",
                    "properties": {
                      "avatar_url": {
                        "type": "string"
                      },
                      "created_at": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "roles": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "id",
                      "email",
                      "name",
                      "roles",
                      "created_at",
                      "avatar_url"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "user"
                ],
                "title": "MeResponse",
                "type": "object"
              }
            }
          },
          "description": "Successful response"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Get current user",
      "tags": [
        "auth"
      ]
    },
    "patch": {
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "description": "`PATCH /b/auth/api/me` request body. Every field is optional and only the\nones present are applied. `name` and `avatar_url` are the only\nuser-editable profile fields: email changes go through verification and\nroles through the admin API.",
              "properties": {
                "avatar_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "title": "UpdateMeRequest",
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`GET /b/auth/api/me` and `PATCH /b/auth/api/me` response body.",
                "properties": {
                  "user": {
                    "description": "The caller's own profile.",
                    "properties": {
                      "avatar_url": {
                        "type": "string"
                      },
                      "created_at": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "roles": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "id",
                      "email",
                      "name",
                      "roles",
                      "created_at",
                      "avatar_url"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "user"
                ],
                "title": "MeResponse",
                "type": "object"
              }
            }
          },
          "description": "Successful response"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Update current user profile",
      "tags": [
        "auth"
      ]
    }
  },
  "/b/auth/api/refresh": {
    "post": {
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "description": "`POST /b/auth/api/refresh` request body.",
              "properties": {
                "refresh_token": {
                  "type": "string"
                }
              },
              "required": [
                "refresh_token"
              ],
              "title": "RefreshRequest",
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/auth/api/refresh` response body: the rotated token pair only.\nRefresh does not re-resolve `default_redirect` or the user projection, so\nneither is present.",
                "properties": {
                  "access_token": {
                    "type": "string"
                  },
                  "expires_in": {
                    "description": "Access token lifetime in seconds",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "refresh_token": {
                    "type": "string"
                  },
                  "token_type": {
                    "description": "The only `token_type` this API issues.",
                    "enum": [
                      "Bearer"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "access_token",
                  "refresh_token",
                  "token_type",
                  "expires_in"
                ],
                "title": "RefreshResponse",
                "type": "object"
              }
            }
          },
          "description": "Successful response"
        }
      },
      "summary": "Rotate an access/refresh token pair",
      "tags": [
        "auth"
      ]
    }
  },
  "/b/auth/api/signup": {
    "post": {
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "description": "`POST /b/auth/api/signup` request body.",
              "properties": {
                "email": {
                  "format": "email",
                  "type": "string"
                },
                "name": {
                  "description": "Optional display name",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "email",
                "password"
              ],
              "title": "SignupRequest",
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/auth/api/signup` response body.\n\nAuto-logs in (issues tokens) unless email verification is required, in\nwhich case only email_verified/message/user are returned.",
                "properties": {
                  "access_token": {
                    "type": "string"
                  },
                  "default_redirect": {
                    "type": "string"
                  },
                  "email_verified": {
                    "type": "boolean"
                  },
                  "expires_in": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "message": {
                    "description": "Present when verification is required or the email is already registered",
                    "type": "string"
                  },
                  "refresh_token": {
                    "type": "string"
                  },
                  "token_type": {
                    "description": "The only `token_type` this API issues.",
                    "enum": [
                      "Bearer"
                    ],
                    "type": "string"
                  },
                  "user": {
                    "description": "The new account. `roles` and `name` are present only on the auto-login\npath; the verification-required reply carries `id` and `email` alone.",
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "roles": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "id",
                      "email"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "email_verified",
                  "user"
                ],
                "title": "SignupResponse",
                "type": "object"
              }
            }
          },
          "description": "Successful response"
        }
      },
      "summary": "Create account",
      "tags": [
        "auth"
      ]
    }
  }
}