{
  "/b/dev/api/status": {
    "get": {
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "Response of `GET /b/dev/api/status`.",
                "properties": {
                  "activation": {
                    "additionalProperties": false,
                    "description": "The activation in progress, if any.",
                    "properties": {
                      "detail": {
                        "description": "Human-readable detail for the progress panel.",
                        "type": "string"
                      },
                      "generation_id": {
                        "description": "The generation being activated.",
                        "type": "string"
                      },
                      "phase": {
                        "description": "Which phase it has reached.",
                        "oneOf": [
                          {
                            "const": "idle",
                            "description": "Nothing in flight.",
                            "type": "string"
                          },
                          {
                            "const": "validating",
                            "description": "Hashes, manifests and guests are being checked.",
                            "type": "string"
                          },
                          {
                            "const": "building_runtime",
                            "description": "A candidate runtime is being constructed from the block set.",
                            "type": "string"
                          },
                          {
                            "const": "publishing",
                            "description": "The site files are being written into `wafer-run/web/site`.",
                            "type": "string"
                          },
                          {
                            "const": "active",
                            "description": "The generation is live.",
                            "type": "string"
                          },
                          {
                            "const": "failed",
                            "description": "The activation was abandoned; the previous generation is still live.",
                            "type": "string"
                          }
                        ]
                      }
                    },
                    "required": [
                      "generation_id",
                      "phase",
                      "detail"
                    ],
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "active_generation": {
                    "additionalProperties": false,
                    "description": "The active generation, or null on a fresh instance.",
                    "properties": {
                      "activated_at": {
                        "description": "RFC 3339 time the generation went live, or null if it never did.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "blocks": {
                        "description": "Number of blocks in the generation's block manifest.",
                        "format": "uint32",
                        "minimum": 0,
                        "type": "integer"
                      },
                      "cause": {
                        "description": "What created this generation.",
                        "oneOf": [
                          {
                            "const": "site_write",
                            "description": "A `site/**` write. Site-only — no runtime rebuild.",
                            "type": "string"
                          },
                          {
                            "const": "site_delete",
                            "description": "A `site/**` delete. Site-only — no runtime rebuild.",
                            "type": "string"
                          },
                          {
                            "const": "block_compile",
                            "description": "A successful compile stage; the block set changed.",
                            "type": "string"
                          },
                          {
                            "const": "block_remove",
                            "description": "A block was removed; the block set changed.",
                            "type": "string"
                          },
                          {
                            "const": "rollback",
                            "description": "A republish of an earlier generation's manifests.",
                            "type": "string"
                          },
                          {
                            "const": "seed",
                            "description": "Generation 0, imported from the seed bundle on cold boot.",
                            "type": "string"
                          }
                        ]
                      },
                      "created_at": {
                        "description": "RFC 3339 creation time.",
                        "type": "string"
                      },
                      "id": {
                        "description": "Generation id.",
                        "type": "string"
                      },
                      "parent_id": {
                        "description": "The generation this one was derived from, or null for the first.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "site_files": {
                        "description": "Number of files in the generation's site manifest.",
                        "format": "uint32",
                        "minimum": 0,
                        "type": "integer"
                      },
                      "status": {
                        "description": "Where the generation sits in its lifecycle.",
                        "oneOf": [
                          {
                            "const": "staged",
                            "description": "Recorded, not yet examined.",
                            "type": "string"
                          },
                          {
                            "const": "validating",
                            "description": "Blobs, artifacts and guests are being checked.",
                            "type": "string"
                          },
                          {
                            "const": "activating",
                            "description": "The runtime swap and site publish are in progress.",
                            "type": "string"
                          },
                          {
                            "const": "active",
                            "description": "Currently serving.",
                            "type": "string"
                          },
                          {
                            "const": "failed",
                            "description": "Abandoned; `failure_message` says why.",
                            "type": "string"
                          },
                          {
                            "const": "superseded",
                            "description": "Aged out of the retention window.",
                            "type": "string"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "parent_id",
                      "cause",
                      "status",
                      "created_at",
                      "activated_at",
                      "site_files",
                      "blocks"
                    ],
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "blocks": {
                    "description": "Blocks in the active generation.",
                    "items": {
                      "additionalProperties": false,
                      "description": "A block serving in the active generation.",
                      "properties": {
                        "artifact_sha256": {
                          "description": "SHA-256 of the artifact the block was loaded from, hex-encoded.",
                          "type": "string"
                        },
                        "name": {
                          "description": "Registered block name.",
                          "type": "string"
                        },
                        "routes": {
                          "description": "Route prefixes the block serves, with the access tier the router\nenforces for each.",
                          "items": {
                            "description": "One route prefix a dynamically-registered block serves.",
                            "properties": {
                              "access": {
                                "description": "Access tier the router enforces for the prefix.",
                                "oneOf": [
                                  {
                                    "const": "Public",
                                    "description": "No auth check; anyone may reach the route.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "Authenticated",
                                    "description": "A resolved user identity is required.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "Admin",
                                    "description": "The `admin` role is required.",
                                    "type": "string"
                                  }
                                ]
                              },
                              "prefix": {
                                "description": "Route prefix, normalized and under `/b/{block}/`.",
                                "type": "string"
                              }
                            },
                            "required": [
                              "prefix",
                              "access"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "name",
                        "artifact_sha256",
                        "routes"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "runtime_generation": {
                    "description": "Bumped on every runtime rebuild; the page refreshes tool registrations\nwhen it changes.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "wafer_guest_version": {
                    "description": "`wafer_guest.rs` version the block scaffolder currently writes.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "active_generation",
                  "runtime_generation",
                  "blocks",
                  "activation",
                  "wafer_guest_version"
                ],
                "title": "StatusResponse",
                "type": "object"
              }
            }
          },
          "description": "Successful response"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Sandbox status"
    }
  }
}